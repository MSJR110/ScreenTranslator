<Window x:Class="ScreenTranslator.UI.TrayFlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:ScreenTranslator.UI"
        Title="ScreenTranslator"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        SizeToContent="Height"
        Width="336"
        FlowDirection="{ui:Flow}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        KeyDown="OnKeyDown"
        Deactivated="OnDeactivated">

    <Window.Resources>
        <!-- One quick action: gradient icon tile, label, hotkey chip -->
        <Style x:Key="ActionTile" TargetType="Button" BasedOn="{StaticResource TileButton}">
            <Setter Property="Margin" Value="4" />
            <Setter Property="Padding" Value="12,12,12,10" />
        </Style>
        <Style x:Key="TileLabel" TargetType="TextBlock" BasedOn="{StaticResource Label}">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,10,0,2" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="TileKey" TargetType="TextBlock" BasedOn="{StaticResource MutedLabel}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FlowDirection" Value="LeftToRight" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
        <Style x:Key="FooterButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="34" />
            <Setter Property="FontSize" Value="15" />
        </Style>
        <Style x:Key="LiveChoice" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Padding" Value="0,7" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Margin" Value="3,0" />
        </Style>
    </Window.Resources>

    <Border x:Name="Shell" Background="{DynamicResource SurfaceTint}">
        <Grid>
            <Rectangle Fill="{DynamicResource Ambient}" IsHitTestVisible="False" />

            <Grid x:Name="Root" RenderTransformOrigin="0.5,1">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="Slide" Y="0" />
                </Grid.RenderTransform>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0" Margin="18,16,14,10">
                    <StackPanel Orientation="Horizontal">
                        <Image x:Name="Logo" Width="38" Height="38" Margin="0,0,12,0" VerticalAlignment="Center" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource Label}" FontSize="15" FontWeight="Bold" Text="ScreenTranslator" FlowDirection="LeftToRight" HorizontalAlignment="Left" />
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <Grid Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <Ellipse x:Name="StatusPulse" Fill="{DynamicResource Success}" Opacity="0" />
                                    <Ellipse x:Name="StatusDot" Fill="{DynamicResource Muted}" Width="6" Height="6" />
                                </Grid>
                                <TextBlock x:Name="StatusText" Style="{StaticResource MutedLabel}" Text="{ui:L tray.status.ready}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                    <Button Style="{StaticResource FooterButton}" Content="&#xE7E8;" ToolTip="{ui:L tray.exit}" Click="OnExit" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>

                <!-- Quick actions -->
                <UniformGrid Grid.Row="1" Columns="2" Margin="12,0,12,4">
                    <Button x:Name="RegionTile" Style="{StaticResource ActionTile}" Click="OnRegion">
                        <StackPanel>
                            <Border Style="{StaticResource IconTile}" HorizontalAlignment="Left"><TextBlock Style="{StaticResource IconTileGlyph}" Text="&#xE7A8;" /></Border>
                            <TextBlock Style="{StaticResource TileLabel}" Text="{ui:L tray.tile.region}" />
                            <TextBlock x:Name="RegionKey" Style="{StaticResource TileKey}" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="SelectionTile" Style="{StaticResource ActionTile}" Click="OnSelection">
                        <StackPanel>
                            <Border Style="{StaticResource IconTile}" HorizontalAlignment="Left"><TextBlock Style="{StaticResource IconTileGlyph}" Text="&#xE8D2;" /></Border>
                            <TextBlock Style="{StaticResource TileLabel}" Text="{ui:L tray.tile.selection}" />
                            <TextBlock x:Name="SelectionKey" Style="{StaticResource TileKey}" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="WordTile" Style="{StaticResource ActionTile}" Click="OnWord">
                        <StackPanel>
                            <Border Style="{StaticResource IconTile}" HorizontalAlignment="Left"><TextBlock Style="{StaticResource IconTileGlyph}" Text="&#xE82D;" /></Border>
                            <TextBlock Style="{StaticResource TileLabel}" Text="{ui:L tray.tile.word}" />
                            <TextBlock x:Name="WordKey" Style="{StaticResource TileKey}" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="CopyTile" Style="{StaticResource ActionTile}" Click="OnCopy">
                        <StackPanel>
                            <Border Style="{StaticResource IconTile}" HorizontalAlignment="Left"><TextBlock Style="{StaticResource IconTileGlyph}" Text="&#xE8C8;" /></Border>
                            <TextBlock Style="{StaticResource TileLabel}" Text="{ui:L tray.tile.copy}" />
                            <TextBlock x:Name="CopyKey" Style="{StaticResource TileKey}" />
                        </StackPanel>
                    </Button>
                </UniformGrid>

                <!-- Live translation -->
                <Border Grid.Row="2" Style="{StaticResource GlassCard}" Margin="16,6,16,4" Padding="14,12,14,12">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconTileGlyph}" Text="&#xE768;" FontSize="14" Margin="0,0,8,0" />
                                <TextBlock Style="{StaticResource Label}" FontWeight="SemiBold" FontSize="13" Text="{ui:L live.title}" />
                            </StackPanel>
                            <TextBlock x:Name="LiveHint" Style="{StaticResource MutedLabel}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{ui:L tray.live.hint}" />
                        </Grid>
                        <UniformGrid x:Name="LiveChoices" Columns="3" Margin="-3,0">
                            <Button x:Name="LiveRegionButton" Style="{StaticResource LiveChoice}" Content="{ui:L tray.live.region}" Click="OnLiveRegion" />
                            <Button x:Name="LiveWindowButton" Style="{StaticResource LiveChoice}" Content="{ui:L tray.live.window}" Click="OnLiveWindow" />
                            <Button Style="{StaticResource LiveChoice}" Content="{ui:L tray.live.screen}" Click="OnLiveScreen" />
                        </UniformGrid>
                        <Button x:Name="LiveStop" Style="{StaticResource AccentButton}" Content="{ui:L tray.live.stop}" Click="OnLiveStop" Visibility="Collapsed" />
                    </StackPanel>
                </Border>

                <!-- Footer -->
                <Grid Grid.Row="3" Margin="16,8,16,14">
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource FlatButton}" Padding="12,7" Click="OnHistory" Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{DynamicResource IconFont}" FontSize="13" Text="&#xE81C;" Margin="0,0,7,0" VerticalAlignment="Center" />
                                <TextBlock Text="{ui:L tray.history}" FontSize="12.5" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource FlatButton}" Padding="12,7" Click="OnSettings">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{DynamicResource IconFont}" FontSize="13" Text="&#xE713;" Margin="0,0,7,0" VerticalAlignment="Center" />
                                <TextBlock Text="{ui:L tray.settings}" FontSize="12.5" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <Button Style="{StaticResource FooterButton}" Content="&#xE897;" ToolTip="{ui:L tray.help}" Click="OnHelp" HorizontalAlignment="Right" />
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
