<Window x:Class="ScreenTranslator.UI.WordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Word"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        SizeToContent="Height"
        Width="390"
        MaxHeight="560"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        KeyDown="OnKeyDown"
        Deactivated="OnDeactivated">

    <Border x:Name="Shell" Background="{DynamicResource SurfaceTint}">
        <Grid>
            <Rectangle Fill="{DynamicResource Ambient}" IsHitTestVisible="False" />

            <Grid x:Name="Root" RenderTransformOrigin="0.5,0">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="Slide" Y="0" />
                </Grid.RenderTransform>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header: word + IPA (LTR), actions on the right -->
                <Grid Grid.Row="0" Background="#01000000" MouseLeftButtonDown="OnHeaderDrag" Margin="20,16,10,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center" FlowDirection="LeftToRight">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="WordText" Style="{StaticResource GradientTitle}" FontSize="26" FontFamily="Segoe UI Variable Display, Segoe UI" />
                            <Button x:Name="SpeakButton" Style="{StaticResource IconButton}" Content="&#xE767;" FontSize="14" Margin="8,4,0,0"
                                    ToolTip="تلفظ" Click="OnSpeak" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,-2,0,0">
                            <TextBlock x:Name="IpaText" Style="{StaticResource MutedLabel}" FontSize="13" FontFamily="Segoe UI" />
                        </StackPanel>
                        <TextBlock x:Name="LemmaText" Style="{StaticResource MutedLabel}" FontSize="12" FlowDirection="RightToLeft" HorizontalAlignment="Left" Visibility="Collapsed" Margin="0,2,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button x:Name="PinButton" Style="{StaticResource IconButton}" Content="&#xE718;" ToolTip="سنجاق: با کلیک بیرون بسته نشود" Click="OnPinClick" Margin="0,0,2,0" />
                        <Button Style="{StaticResource IconButton}" Content="&#xE711;" ToolTip="بستن (Esc)" Click="OnCloseClick" />
                    </StackPanel>
                </Grid>

                <!-- Persian meaning: the hero card -->
                <Border Grid.Row="1" Margin="18,10,18,6" Background="{DynamicResource AccentGradientSoft}" BorderBrush="{DynamicResource Rim}" BorderThickness="1"
                        CornerRadius="14" Padding="16,12">
                    <Grid>
                        <TextBox x:Name="TranslationBox" Style="{StaticResource ReadOnlyText}" Foreground="{DynamicResource Text}" FontSize="19" FontWeight="SemiBold"
                                 FlowDirection="RightToLeft" TextAlignment="Right" VerticalScrollBarVisibility="Disabled" />
                        <Border x:Name="TranslationLoading" Height="14" CornerRadius="7" Background="{DynamicResource ButtonHover}" Width="140" HorizontalAlignment="Right" Margin="0,6" />
                    </Grid>
                </Border>

                <!-- Definitions -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="20,4,20,0" MaxHeight="330">
                    <StackPanel>
                        <StackPanel x:Name="Senses" FlowDirection="LeftToRight" />
                        <StackPanel x:Name="SensesLoading" FlowDirection="LeftToRight" Margin="0,6,0,4">
                            <Border Height="12" CornerRadius="6" Background="{DynamicResource ButtonHover}" Width="60" HorizontalAlignment="Left" Margin="0,0,0,10" />
                            <Border Height="12" CornerRadius="6" Background="{DynamicResource ButtonHover}" Width="300" HorizontalAlignment="Left" Margin="0,0,0,8" />
                            <Border Height="12" CornerRadius="6" Background="{DynamicResource ButtonHover}" Width="240" HorizontalAlignment="Left" Margin="0,0,0,4" />
                        </StackPanel>
                        <TextBlock x:Name="NoDefs" Style="{StaticResource MutedLabel}" Text="تعریفی برای این کلمه پیدا نشد." FlowDirection="RightToLeft" Visibility="Collapsed" Margin="0,6,0,4" />
                    </StackPanel>
                </ScrollViewer>

                <!-- Footer -->
                <Grid Grid.Row="3" Margin="16,10,16,16" FlowDirection="RightToLeft">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="LineButton" Style="{StaticResource FlatButton}" Content="ترجمه‌ی کل خط" Click="OnTranslateLine" Margin="0,0,8,0" />
                        <Button x:Name="CopyButton" Style="{StaticResource FlatButton}" Content="کپی معنی" Click="OnCopy" />
                    </StackPanel>
                    <Border x:Name="SourceChip" Style="{StaticResource Chip}" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="9,2" Visibility="Collapsed">
                        <TextBlock x:Name="SourceText" Style="{StaticResource MutedLabel}" FontSize="11" Text="" />
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
