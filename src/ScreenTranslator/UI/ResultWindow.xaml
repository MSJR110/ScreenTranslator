<Window x:Class="ScreenTranslator.UI.ResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:ScreenTranslator.UI"
        Title="Translation"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        SizeToContent="Height"
        Width="460"
        MinWidth="320"
        MinHeight="170"
        MaxHeight="640"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        KeyDown="OnKeyDown"
        Deactivated="OnDeactivated">

    <Border x:Name="Shell" Background="{DynamicResource SurfaceTint}" CornerRadius="0" Padding="0">
        <Grid>
            <Rectangle Fill="{DynamicResource Ambient}" IsHitTestVisible="False" />

            <Grid x:Name="Root" RenderTransformOrigin="0.5,0">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="Slide" Y="0" />
                </Grid.RenderTransform>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header (drag handle): status chip on the right, window buttons on the left -->
                <Grid Grid.Row="0" Background="#01000000" MouseLeftButtonDown="OnHeaderDrag" Margin="10,10,14,4" FlowDirection="{ui:Flow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource Chip}" HorizontalAlignment="Left" VerticalAlignment="Center" Padding="10,4,8,4">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Ellipse x:Name="StatusDot" Fill="{DynamicResource Accent}" />
                            </Grid>
                            <TextBlock x:Name="StatusText" Style="{StaticResource MutedLabel}" Text="{ui:L result.preparing}" />
                        </StackPanel>
                    </Border>

                    <Button x:Name="PinButton" Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE718;"
                            ToolTip="{ui:L common.pin}" Click="OnPinClick" Margin="0,0,2,0" />
                    <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE711;" ToolTip="{ui:L common.close.esc}" Click="OnCloseClick" />
                </Grid>

                <!-- Original: quiet inset card -->
                <Border x:Name="Divider" Grid.Row="1" Margin="18,6,18,4" Background="{DynamicResource InputBg}" CornerRadius="10" Padding="12,8"
                        BorderBrush="{DynamicResource Divider}" BorderThickness="1">
                    <TextBox x:Name="OriginalBox" Style="{StaticResource ReadOnlyText}"
                             Foreground="{DynamicResource Muted}" FontSize="12.5" MaxHeight="150"
                             FlowDirection="LeftToRight" />
                </Border>

                <!-- Translation: large text with a gradient rail on its reading side -->
                <Grid x:Name="TransGrid" Grid.Row="2" Margin="18,10,18,8" FlowDirection="RightToLeft">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="3" CornerRadius="2" Background="{DynamicResource AccentGradient}" Margin="0,4,12,4" VerticalAlignment="Stretch" />
                    <Grid Grid.Column="1">
                        <TextBox x:Name="TranslationBox" Style="{StaticResource ReadOnlyText}"
                                 Foreground="{DynamicResource Text}" FontSize="16"
                                 FlowDirection="RightToLeft" TextAlignment="Right" />

                        <!-- skeleton shimmer while waiting -->
                        <StackPanel x:Name="Loading">
                            <Border Height="14" CornerRadius="7" Background="{DynamicResource ButtonHover}" Width="300" HorizontalAlignment="Left" Margin="0,4,0,8" />
                            <Border Height="14" CornerRadius="7" Background="{DynamicResource ButtonHover}" Width="360" HorizontalAlignment="Left" Margin="0,0,0,8" />
                            <Border Height="14" CornerRadius="7" Background="{DynamicResource ButtonHover}" Width="220" HorizontalAlignment="Left" Margin="0,0,0,4" />
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- Footer -->
                <Grid Grid.Row="3" Margin="16,6,16,16" FlowDirection="{ui:Flow}">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="CopyButton" Style="{StaticResource AccentButton}" Content="{ui:L result.copy.translation}" Click="OnCopyTranslation" Margin="0,0,8,0" />
                        <Button Style="{StaticResource FlatButton}" Content="{ui:L result.copy.original}" Click="OnCopyOriginal" Margin="0,0,8,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="SpeakButton" Style="{StaticResource IconButton}" Content="&#xE767;" FontSize="15" ToolTip="{ui:L result.speak}" Click="OnSpeak" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
