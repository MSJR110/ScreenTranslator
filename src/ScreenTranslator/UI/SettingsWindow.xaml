<Window x:Class="ScreenTranslator.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:ScreenTranslator.UI"
        Title="تنظیمات ScreenTranslator"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="Transparent"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        Width="700"
        Height="660"
        FlowDirection="RightToLeft"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        KeyDown="OnKeyDown">

    <Window.Resources>
        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="Margin" Value="0,7" />
        </Style>
        <Style x:Key="Card" TargetType="Border" BasedOn="{StaticResource GlassCard}">
            <Setter Property="Padding" Value="16,6,16,12" />
        </Style>
        <Style x:Key="Field" TargetType="TextBox" BasedOn="{StaticResource Input}">
            <Setter Property="Width" Value="250" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="FlowDirection" Value="LeftToRight" />
        </Style>
    </Window.Resources>

    <Border x:Name="Shell" Background="{DynamicResource SurfaceTint}">
        <Grid>
            <Rectangle Fill="{DynamicResource Ambient}" IsHitTestVisible="False" />

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Title bar -->
                <Grid Grid.Row="0" Background="#01000000" MouseLeftButtonDown="OnDrag" Margin="22,18,14,8">
                    <StackPanel Orientation="Horizontal">
                        <Image x:Name="LogoImage" Width="36" Height="36" Margin="0,0,12,0" VerticalAlignment="Center" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource Label}" FontSize="16" FontWeight="Bold" Text="ScreenTranslator" FlowDirection="LeftToRight" HorizontalAlignment="Left" />
                            <TextBlock x:Name="VersionText" Style="{StaticResource MutedLabel}" Text="" />
                        </StackPanel>
                    </StackPanel>
                    <Button Style="{StaticResource IconButton}" Content="&#xE711;" HorizontalAlignment="Right" VerticalAlignment="Top" Click="OnClose" ToolTip="بستن (Esc)" />
                </Grid>

                <!-- Sidebar + page -->
                <Grid Grid.Row="1" Margin="14,6,14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="176" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,8,8,0">
                        <RadioButton x:Name="TabGeneral" Style="{StaticResource NavButton}" Tag="&#xE713;" Content="عمومی" IsChecked="True" Checked="OnTab" />
                        <RadioButton x:Name="TabHotkeys" Style="{StaticResource NavButton}" Tag="&#xE765;" Content="میان‌برها" Checked="OnTab" />
                        <RadioButton x:Name="TabLive" Style="{StaticResource NavButton}" Tag="&#xE768;" Content="ترجمه‌ی زنده" Checked="OnTab" />
                        <RadioButton x:Name="TabEngine" Style="{StaticResource NavButton}" Tag="&#xE8F1;" Content="موتور ترجمه" Checked="OnTab" />
                        <RadioButton x:Name="TabAbout" Style="{StaticResource NavButton}" Tag="&#xE946;" Content="درباره" Checked="OnTab" />
                    </StackPanel>

                    <!-- Pages -->
                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="8,0,0,0" Padding="0,0,6,0">
                        <Grid>
        
                            <!-- ===== General ===== -->
                            <StackPanel x:Name="PageGeneral">
                                <TextBlock Style="{StaticResource SectionTitle}" Text="زبان" />
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <Grid Style="{StaticResource Row}">
                                            <TextBlock Style="{StaticResource Label}" Text="ترجمه به" />
                                            <ComboBox x:Name="TargetCombo" Width="200" HorizontalAlignment="Right" />
                                        </Grid>
                                        <Grid Style="{StaticResource Row}">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource Label}" Text="زبان OCR (خواندن متن از تصویر)" />
                                                <TextBlock Style="{StaticResource MutedLabel}" TextWrapping="Wrap" MaxWidth="260" HorizontalAlignment="Left"
                                                           Text="برای زبان‌های دیگر، از Settings › Time &amp; language › Language بسته‌ی زبان را با گزینه‌ی OCR نصب کن." />
                                            </StackPanel>
                                            <ComboBox x:Name="OcrCombo" Width="200" HorizontalAlignment="Right" VerticalAlignment="Top" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
        
                                <TextBlock Style="{StaticResource SectionTitle}" Text="ظاهر" />
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <Grid Style="{StaticResource Row}">
                                            <TextBlock Style="{StaticResource Label}" Text="تم" />
                                            <ComboBox x:Name="ThemeCombo" Width="200" HorizontalAlignment="Right">
                                                <ComboBoxItem Tag="system">همراه با ویندوز</ComboBoxItem>
                                                <ComboBoxItem Tag="dark">تیره</ComboBoxItem>
                                                <ComboBoxItem Tag="light">روشن</ComboBoxItem>
                                            </ComboBox>
                                        </Grid>
                                        <Grid Style="{StaticResource Row}">
                                            <TextBlock Style="{StaticResource Label}" Text="اندازه‌ی فونت ترجمه در پاپ‌آپ" />
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <TextBlock x:Name="PopupFontValue" Style="{StaticResource MutedLabel}" Width="30" TextAlignment="Center" />
                                                <Slider x:Name="PopupFontSlider" Minimum="12" Maximum="26" TickFrequency="1" ValueChanged="OnSliderChanged" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
        
                                <TextBlock Style="{StaticResource SectionTitle}" Text="رفتار" />
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <CheckBox x:Name="StartupCheck" Content="اجرا هنگام روشن شدن ویندوز" />
                                        <CheckBox x:Name="SpeakCheck" Content="دکمه‌ی خواندن متن اصلی در پاپ‌آپ" />
                                        <CheckBox x:Name="HistoryCheck" Content="ذخیره‌ی تاریخچه‌ی ترجمه‌ها (روی همین سیستم)" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
        
                            <!-- ===== Hotkeys ===== -->
                            <StackPanel x:Name="PageHotkeys" Visibility="Collapsed">
                                <TextBlock Style="{StaticResource SectionTitle}" Text="میان‌برهای سراسری" />
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource MutedLabel}" Margin="0,4,0,6" TextWrapping="Wrap"
                                                   Text="روی کادر کلیک کن و ترکیب جدید را بزن. Backspace برای حذف. ترکیب باید Ctrl/Alt/Shift/Win یا یک کلید F داشته باشد." />
                                        <Grid Style="{StaticResource Row}">
                                            <TextBlock Style="{StaticResource Label}" Text="ترجمه‌ی ناحیه" />
                                            <ui:HotkeyBox x:Name="HkRegion" HorizontalAlignment="Right" />
                                        </Grid>
                                        <Grid Style="{StaticResource Row}">
                                            <TextBlock Style="{StaticResource Label}" Text="ترجمه‌ی متن انتخاب‌شده" />
                                            <ui:HotkeyBox x:Name="HkSelection" HorizontalAlignment="Right" />
                                        </Grid>
                                        <Grid Style="{StaticResource Row}">
                                            <TextBlock Style="{StaticResource Label}" Text="ترجمه‌ی زنده‌ی ناحیه (شروع/پایان)" />
                                            <ui:HotkeyBox x:Name="HkLiveRegion" HorizontalAlignment="Right" />
                                        </Grid>
                                        <Grid Style="{StaticResource Row}">
                                            <TextBlock Style="{StaticResource Label}" Text="ترجمه‌ی زنده‌ی پنجره‌ی فعال" />
                                            <ui:HotkeyBox x:Name="HkLiveWindow" HorizontalAlignment="Right" />
                                        </Grid>
                                        <Grid Style="{StaticResource Row}">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource Label}" Text="معنی کلمه‌ی زیر موس" />
                                                <TextBlock Style="{StaticResource MutedLabel}" Text="تلفظ، معنی فارسی و تعریف انگلیسی" />
                                            </StackPanel>
                                            <ui:HotkeyBox x:Name="HkWord" HorizontalAlignment="Right" VerticalAlignment="Top" />
                                        </Grid>
                                        <Grid Style="{StaticResource Row}">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource Label}" Text="کپی متن از تصویر" />
                                                <TextBlock Style="{StaticResource MutedLabel}" Text="OCR بدون ترجمه؛ متن به کلیپ‌بورد می‌رود" />
                                            </StackPanel>
                                            <ui:HotkeyBox x:Name="HkCopy" HorizontalAlignment="Right" VerticalAlignment="Top" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
        
                                <TextBlock Style="{StaticResource SectionTitle}" Text="داخل برنامه" />
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <Grid Style="{StaticResource Row}">
                                            <TextBlock Style="{StaticResource Label}" Text="دیدن متن اصلی زیر ترجمه‌ی زنده" />
                                            <TextBlock Style="{StaticResource MutedLabel}" HorizontalAlignment="Right" Text="نگه‌داشتن Ctrl" />
                                        </Grid>
                                        <Grid Style="{StaticResource Row}">
                                            <TextBlock Style="{StaticResource Label}" Text="بستن پاپ‌آپ / لغو انتخاب" />
                                            <TextBlock Style="{StaticResource MutedLabel}" HorizontalAlignment="Right" Text="Esc" />
                                        </Grid>
                                        <Grid Style="{StaticResource Row}">
                                            <TextBlock Style="{StaticResource Label}" Text="کپی ترجمه در پاپ‌آپ" />
                                            <TextBlock Style="{StaticResource MutedLabel}" HorizontalAlignment="Right" Text="Ctrl+C" />
                                        </Grid>
                                        <Grid Style="{StaticResource Row}">
                                            <TextBlock Style="{StaticResource Label}" Text="تغییر اندازه‌ی پاپ‌آپ / برگشت به اندازه‌ی خودکار" />
                                            <TextBlock Style="{StaticResource MutedLabel}" HorizontalAlignment="Right" Text="کشیدن لبه / دابل‌کلیک سرتیتر" />
                                        </Grid>
                                        <Grid Style="{StaticResource Row}">
                                            <TextBlock Style="{StaticResource Label}" Text="تلفظ در کارت کلمه" />
                                            <TextBlock Style="{StaticResource MutedLabel}" HorizontalAlignment="Right" Text="Space" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
        
                            <!-- ===== Live ===== -->
                            <StackPanel x:Name="PageLive" Visibility="Collapsed">
                                <TextBlock Style="{StaticResource SectionTitle}" Text="ترجمه‌ی زنده" />
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <Grid Style="{StaticResource Row}">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource Label}" Text="فاصله‌ی بررسی صفحه" />
                                                <TextBlock Style="{StaticResource MutedLabel}" Text="کمتر = واکنش سریع‌تر، کمی CPU بیشتر" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <TextBlock x:Name="IntervalValue" Style="{StaticResource MutedLabel}" Width="52" TextAlignment="Center" />
                                                <Slider x:Name="IntervalSlider" Minimum="300" Maximum="2000" TickFrequency="100" ValueChanged="OnSliderChanged" />
                                            </StackPanel>
                                        </Grid>
                                        <Grid Style="{StaticResource Row}">
                                            <TextBlock Style="{StaticResource Label}" Text="پوشانندگی جعبه‌های ترجمه" />
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <TextBlock x:Name="OpacityValue" Style="{StaticResource MutedLabel}" Width="40" TextAlignment="Center" />
                                                <Slider x:Name="OpacitySlider" Minimum="50" Maximum="100" TickFrequency="2" ValueChanged="OnSliderChanged" />
                                            </StackPanel>
                                        </Grid>
                                        <Grid Style="{StaticResource Row}">
                                            <TextBlock Style="{StaticResource Label}" Text="اندازه‌ی فونت روی صفحه" />
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <TextBlock x:Name="FontScaleValue" Style="{StaticResource MutedLabel}" Width="40" TextAlignment="Center" />
                                                <Slider x:Name="FontScaleSlider" Minimum="70" Maximum="140" TickFrequency="5" ValueChanged="OnSliderChanged" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
        
                            <!-- ===== Engine ===== -->
                            <StackPanel x:Name="PageEngine" Visibility="Collapsed">
                                <TextBlock Style="{StaticResource SectionTitle}" Text="موتور ترجمه" />
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <Border Background="{DynamicResource InputBg}" CornerRadius="9" Padding="4" Margin="0,6,0,4" HorizontalAlignment="Left">
                                            <StackPanel Orientation="Horizontal">
                                                <RadioButton x:Name="EngineGoogle" Content="Google" GroupName="Engine" Checked="OnEngineChanged" />
                                                <RadioButton x:Name="EngineClaude" Content="Claude" GroupName="Engine" Checked="OnEngineChanged" />
                                                <RadioButton x:Name="EngineOpenAi" Content="سازگار با OpenAI" GroupName="Engine" Checked="OnEngineChanged" />
                                            </StackPanel>
                                        </Border>
                                        <TextBlock x:Name="EngineHint" Style="{StaticResource MutedLabel}" TextWrapping="Wrap" Margin="0,4,0,6" />
                                    </StackPanel>
                                </Border>
        
                                <StackPanel x:Name="ClaudePanel" Visibility="Collapsed">
                                    <TextBlock Style="{StaticResource SectionTitle}" Text="Claude · Anthropic" />
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <Grid Style="{StaticResource Row}">
                                                <TextBlock Style="{StaticResource Label}" Text="کلید API" />
                                                <PasswordBox x:Name="ClaudeKey" Width="250" HorizontalAlignment="Right" FlowDirection="LeftToRight" />
                                            </Grid>
                                            <Grid Style="{StaticResource Row}">
                                                <TextBlock Style="{StaticResource Label}" Text="مدل" />
                                                <ComboBox x:Name="ClaudeModel" Width="250" HorizontalAlignment="Right" FlowDirection="LeftToRight" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
        
                                <StackPanel x:Name="OpenAiPanel" Visibility="Collapsed">
                                    <TextBlock Style="{StaticResource SectionTitle}" Text="سرویس سازگار با OpenAI" />
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource MutedLabel}" TextWrapping="Wrap" Margin="0,4,0,4"
                                                       Text="OpenAI، OpenRouter، Groq، DeepSeek، Ollama/LM Studio محلی، یا هر پروکسی که فرمت chat/completions را بفهمد." />
                                            <Grid Style="{StaticResource Row}">
                                                <TextBlock Style="{StaticResource Label}" Text="Base URL" />
                                                <TextBox x:Name="OpenAiUrl" Style="{StaticResource Field}" />
                                            </Grid>
                                            <Grid Style="{StaticResource Row}">
                                                <TextBlock Style="{StaticResource Label}" Text="کلید API" />
                                                <PasswordBox x:Name="OpenAiKey" Width="250" HorizontalAlignment="Right" FlowDirection="LeftToRight" />
                                            </Grid>
                                            <Grid Style="{StaticResource Row}">
                                                <TextBlock Style="{StaticResource Label}" Text="مدل" />
                                                <TextBox x:Name="OpenAiModel" Style="{StaticResource Field}" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
        
                                <StackPanel x:Name="TestPanel" Orientation="Horizontal" Margin="0,12,0,0" Visibility="Collapsed">
                                    <Button x:Name="TestButton" Style="{StaticResource FlatButton}" Content="تست اتصال" Click="OnTestEngine" />
                                    <TextBlock x:Name="TestResult" Style="{StaticResource MutedLabel}" Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="330" />
                                </StackPanel>
                            </StackPanel>
        
                            <!-- ===== About ===== -->
                            <StackPanel x:Name="PageAbout" Visibility="Collapsed">
                                <Border Style="{StaticResource Card}" Margin="0,18,0,0" Padding="20,18">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <Image x:Name="AboutLogo" Width="48" Height="48" Margin="0,0,14,0" />
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource Label}" FontSize="18" FontWeight="SemiBold" Text="ScreenTranslator" />
                                                <TextBlock x:Name="AboutVersion" Style="{StaticResource MutedLabel}" />
                                            </StackPanel>
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource Label}" TextWrapping="Wrap" LineHeight="24"
                                                   Text="هر متنی روی صفحه را با یک میان‌بر بخوان و ترجمه کن؛ یا یک ناحیه را زنده ترجمه کن تا صفحه انگار از اول فارسی نوشته شده باشد." />
                                        <Rectangle Height="1" Fill="{DynamicResource Divider}" Margin="0,14" />
                                        <TextBlock Style="{StaticResource MutedLabel}" TextWrapping="Wrap" LineHeight="22"
                                                   Text="OCR: موتور داخلی ویندوز (آفلاین)  ·  ترجمه: Google / Claude / سازگار با OpenAI  ·  فونت: Vazirmatn (SIL OFL)  ·  ساخته‌شده با .NET و WPF" />
                                        <TextBlock Style="{StaticResource MutedLabel}" Margin="0,8,0,0"
                                                   Text="کلیدهای API فقط روی همین سیستم و به‌صورت رمزشده (DPAPI) ذخیره می‌شوند." />
                                        <Rectangle Height="1" Fill="{DynamicResource Divider}" Margin="0,14" />
                                        <TextBlock Style="{StaticResource MutedLabel}">
                                            <Run Text="ساخته‌ی " />
                                            <Hyperlink NavigateUri="https://msjr.ir/work/screentranslator?ref=app" RequestNavigate="OnOpenLink"
                                                       Foreground="{StaticResource Accent}" TextDecorations="{x:Null}" ToolTip="msjr.ir">
                                                <Run Text="MSJR" FontWeight="SemiBold" /><Run Text="  ·  msjr.ir ↗" />
                                            </Hyperlink>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                                <Button Style="{StaticResource FlatButton}" Content="نمایش دوباره‌ی راهنمای شروع" HorizontalAlignment="Left" Margin="0,14,0,0" Click="OnShowWelcome" />
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Grid>

                <!-- Footer -->
                <Grid Grid.Row="2" Margin="22,12,22,18">
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource AccentButton}" Content="ذخیره" Width="104" Click="OnSave" Margin="0,0,8,0" />
                        <Button Style="{StaticResource FlatButton}" Content="بستن" Width="90" Click="OnClose" />
                    </StackPanel>
                    <TextBlock x:Name="SavedHint" Style="{StaticResource MutedLabel}" HorizontalAlignment="Right" VerticalAlignment="Center" Opacity="0" Text="ذخیره شد ✓" />
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
