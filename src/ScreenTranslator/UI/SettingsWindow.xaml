<Window x:Class="ScreenTranslator.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:ScreenTranslator.UI"
        Title="{ui:L settings.title}"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="Transparent"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        Width="700"
        Height="660"
        FlowDirection="{ui:Flow}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        KeyDown="OnKeyDown">

    <Window.Resources>
        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="Margin" Value="0,7" />
        </Style>
        <Style x:Key="Card" TargetType="Border" BasedOn="{StaticResource GlassCard}">
            <Setter Property="Padding" Value="16,6,16,12" />
        </Style>
        <Style x:Key="Field" TargetType="TextBox" BasedOn="{StaticResource Input}">
            <Setter Property="Width" Value="250" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="FlowDirection" Value="LeftToRight" />
        </Style>
    </Window.Resources>

    <Border x:Name="Shell" Background="{DynamicResource SurfaceTint}">
        <Grid>
            <Rectangle Fill="{DynamicResource Ambient}" IsHitTestVisible="False" />

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Title bar -->
                <Grid Grid.Row="0" Background="#01000000" MouseLeftButtonDown="OnDrag" Margin="22,18,14,8">
                    <StackPanel Orientation="Horizontal">
                        <Image x:Name="LogoImage" Width="36" Height="36" Margin="0,0,12,0" VerticalAlignment="Center" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource Label}" FontSize="16" FontWeight="Bold" Text="ScreenTranslator" FlowDirection="LeftToRight" HorizontalAlignment="Left" />
                            <TextBlock x:Name="VersionText" Style="{StaticResource MutedLabel}" Text="" />
                        </StackPanel>
                    </StackPanel>
                    <Button Style="{StaticResource IconButton}" Content="&#xE711;" HorizontalAlignment="Right" VerticalAlignment="Top" Click="OnClose" ToolTip="{ui:L common.close.esc}" />
                </Grid>

                <!-- Sidebar + page -->
                <Grid Grid.Row="1" Margin="14,6,14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="176" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,8,8,0">
                        <RadioButton x:Name="TabGeneral" Style="{StaticResource NavButton}" Tag="&#xE713;" Content="{ui:L settings.tab.general}" IsChecked="True" Checked="OnTab" />
                        <RadioButton x:Name="TabHotkeys" Style="{StaticResource NavButton}" Tag="&#xE765;" Content="{ui:L settings.tab.hotkeys}" Checked="OnTab" />
                        <RadioButton x:Name="TabLive" Style="{StaticResource NavButton}" Tag="&#xE768;" Content="{ui:L settings.tab.live}" Checked="OnTab" />
                        <RadioButton x:Name="TabEngine" Style="{StaticResource NavButton}" Tag="&#xE8F1;" Content="{ui:L settings.tab.engine}" Checked="OnTab" />
                        <RadioButton x:Name="TabAbout" Style="{StaticResource NavButton}" Tag="&#xE946;" Content="{ui:L settings.tab.about}" Checked="OnTab" />
                    </StackPanel>

                    <!-- Pages -->
                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="8,0,0,0" Padding="0,0,6,0">
                        <Grid>
        
                            <!-- ===== General ===== -->
                            <StackPanel x:Name="PageGeneral">
                                <TextBlock Style="{StaticResource SectionTitle}" Text="{ui:L settings.section.language}" />
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <Grid Style="{StaticResource Row}">
                                            <TextBlock Style="{StaticResource Label}" Text="{ui:L settings.target}" />
                                            <ComboBox x:Name="TargetCombo" Width="200" HorizontalAlignment="Right" />
                                        </Grid>
                                        <Grid Style="{StaticResource Row}">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource Label}" Text="{ui:L settings.uilang}" />
                                                <TextBlock Style="{StaticResource MutedLabel}" TextWrapping="Wrap" MaxWidth="260" HorizontalAlignment="Left"
                                                           Text="{ui:L settings.uilang.hint}" />
                                            </StackPanel>
                                            <ComboBox x:Name="UiLangCombo" Width="200" HorizontalAlignment="Right" VerticalAlignment="Top">
                                                <ComboBoxItem Tag="auto" Content="{ui:L settings.uilang.auto}" />
                                                <ComboBoxItem Tag="fa" Content="فارسی" />
                                                <ComboBoxItem Tag="en" Content="English" />
                                            </ComboBox>
                                        </Grid>
                                        <Grid Style="{StaticResource Row}">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource Label}" Text="{ui:L settings.ocr}" />
                                                <TextBlock Style="{StaticResource MutedLabel}" TextWrapping="Wrap" MaxWidth="260" HorizontalAlignment="Left"
                                                           Text="{ui:L settings.ocr.hint}" />
                                            </StackPanel>
                                            <ComboBox x:Name="OcrCombo" Width="200" HorizontalAlignment="Right" VerticalAlignment="Top" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
        
                                <TextBlock Style="{StaticResource SectionTitle}" Text="{ui:L settings.section.look}" />
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <Grid Style="{StaticResource Row}">
                                            <TextBlock Style="{StaticResource Label}" Text="{ui:L settings.theme}" />
                                            <ComboBox x:Name="ThemeCombo" Width="200" HorizontalAlignment="Right">
                                                <ComboBoxItem Tag="system" Content="{ui:L settings.theme.system}" />
                                                <ComboBoxItem Tag="dark" Content="{ui:L settings.theme.dark}" />
                                                <ComboBoxItem Tag="light" Content="{ui:L settings.theme.light}" />
                                            </ComboBox>
                                        </Grid>
                                        <Grid Style="{StaticResource Row}">
                                            <TextBlock Style="{StaticResource Label}" Text="{ui:L settings.popupfont}" />
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <TextBlock x:Name="PopupFontValue" Style="{StaticResource MutedLabel}" Width="30" TextAlignment="Center" />
                                                <Slider x:Name="PopupFontSlider" Minimum="12" Maximum="26" TickFrequency="1" ValueChanged="OnSliderChanged" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
        
                                <TextBlock Style="{StaticResource SectionTitle}" Text="{ui:L settings.section.behavior}" />
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <CheckBox x:Name="StartupCheck" Content="{ui:L settings.startup}" />
                                        <CheckBox x:Name="SpeakCheck" Content="{ui:L settings.speak}" />
                                        <CheckBox x:Name="HistoryCheck" Content="{ui:L settings.history}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
        
                            <!-- ===== Hotkeys ===== -->
                            <StackPanel x:Name="PageHotkeys" Visibility="Collapsed">
                                <TextBlock Style="{StaticResource SectionTitle}" Text="{ui:L settings.section.hotkeys}" />
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource MutedLabel}" Margin="0,4,0,6" TextWrapping="Wrap"
                                                   Text="{ui:L settings.hotkeys.hint}" />
                                        <Grid Style="{StaticResource Row}">
                                            <TextBlock Style="{StaticResource Label}" Text="{ui:L settings.hk.region}" />
                                            <ui:HotkeyBox x:Name="HkRegion" HorizontalAlignment="Right" />
                                        </Grid>
                                        <Grid Style="{StaticResource Row}">
                                            <TextBlock Style="{StaticResource Label}" Text="{ui:L settings.hk.selection}" />
                                            <ui:HotkeyBox x:Name="HkSelection" HorizontalAlignment="Right" />
                                        </Grid>
                                        <Grid Style="{StaticResource Row}">
                                            <TextBlock Style="{StaticResource Label}" Text="{ui:L settings.hk.liveregion}" />
                                            <ui:HotkeyBox x:Name="HkLiveRegion" HorizontalAlignment="Right" />
                                        </Grid>
                                        <Grid Style="{StaticResource Row}">
                                            <TextBlock Style="{StaticResource Label}" Text="{ui:L settings.hk.livewindow}" />
                                            <ui:HotkeyBox x:Name="HkLiveWindow" HorizontalAlignment="Right" />
                                        </Grid>
                                        <Grid Style="{StaticResource Row}">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource Label}" Text="{ui:L settings.hk.word}" />
                                                <TextBlock Style="{StaticResource MutedLabel}" Text="{ui:L settings.hk.word.hint}" />
                                            </StackPanel>
                                            <ui:HotkeyBox x:Name="HkWord" HorizontalAlignment="Right" VerticalAlignment="Top" />
                                        </Grid>
                                        <Grid Style="{StaticResource Row}">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource Label}" Text="{ui:L settings.hk.copy}" />
                                                <TextBlock Style="{StaticResource MutedLabel}" Text="{ui:L settings.hk.copy.hint}" />
                                            </StackPanel>
                                            <ui:HotkeyBox x:Name="HkCopy" HorizontalAlignment="Right" VerticalAlignment="Top" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
        
                                <TextBlock Style="{StaticResource SectionTitle}" Text="{ui:L settings.section.inapp}" />
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <Grid Style="{StaticResource Row}">
                                            <TextBlock Style="{StaticResource Label}" Text="{ui:L settings.inapp.peek}" />
                                            <TextBlock Style="{StaticResource MutedLabel}" HorizontalAlignment="Right" Text="{ui:L settings.inapp.peek.key}" />
                                        </Grid>
                                        <Grid Style="{StaticResource Row}">
                                            <TextBlock Style="{StaticResource Label}" Text="{ui:L settings.inapp.close}" />
                                            <TextBlock Style="{StaticResource MutedLabel}" HorizontalAlignment="Right" Text="Esc" />
                                        </Grid>
                                        <Grid Style="{StaticResource Row}">
                                            <TextBlock Style="{StaticResource Label}" Text="{ui:L settings.inapp.copy}" />
                                            <TextBlock Style="{StaticResource MutedLabel}" HorizontalAlignment="Right" Text="Ctrl+C" />
                                        </Grid>
                                        <Grid Style="{StaticResource Row}">
                                            <TextBlock Style="{StaticResource Label}" Text="{ui:L settings.inapp.resize}" />
                                            <TextBlock Style="{StaticResource MutedLabel}" HorizontalAlignment="Right" Text="{ui:L settings.inapp.resize.key}" />
                                        </Grid>
                                        <Grid Style="{StaticResource Row}">
                                            <TextBlock Style="{StaticResource Label}" Text="{ui:L settings.inapp.speak}" />
                                            <TextBlock Style="{StaticResource MutedLabel}" HorizontalAlignment="Right" Text="Space" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
        
                            <!-- ===== Live ===== -->
                            <StackPanel x:Name="PageLive" Visibility="Collapsed">
                                <TextBlock Style="{StaticResource SectionTitle}" Text="{ui:L settings.tab.live}" />
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <Grid Style="{StaticResource Row}">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource Label}" Text="{ui:L settings.live.interval}" />
                                                <TextBlock Style="{StaticResource MutedLabel}" Text="{ui:L settings.live.interval.hint}" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <TextBlock x:Name="IntervalValue" Style="{StaticResource MutedLabel}" Width="52" TextAlignment="Center" />
                                                <Slider x:Name="IntervalSlider" Minimum="300" Maximum="2000" TickFrequency="100" ValueChanged="OnSliderChanged" />
                                            </StackPanel>
                                        </Grid>
                                        <Grid Style="{StaticResource Row}">
                                            <TextBlock Style="{StaticResource Label}" Text="{ui:L settings.live.opacity}" />
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <TextBlock x:Name="OpacityValue" Style="{StaticResource MutedLabel}" Width="40" TextAlignment="Center" />
                                                <Slider x:Name="OpacitySlider" Minimum="50" Maximum="100" TickFrequency="2" ValueChanged="OnSliderChanged" />
                                            </StackPanel>
                                        </Grid>
                                        <Grid Style="{StaticResource Row}">
                                            <TextBlock Style="{StaticResource Label}" Text="{ui:L settings.live.fontscale}" />
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <TextBlock x:Name="FontScaleValue" Style="{StaticResource MutedLabel}" Width="40" TextAlignment="Center" />
                                                <Slider x:Name="FontScaleSlider" Minimum="70" Maximum="140" TickFrequency="5" ValueChanged="OnSliderChanged" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
        
                            <!-- ===== Engine ===== -->
                            <StackPanel x:Name="PageEngine" Visibility="Collapsed">
                                <TextBlock Style="{StaticResource SectionTitle}" Text="{ui:L settings.tab.engine}" />
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <Border Background="{DynamicResource InputBg}" CornerRadius="9" Padding="4" Margin="0,6,0,4" HorizontalAlignment="Left">
                                            <StackPanel Orientation="Horizontal">
                                                <RadioButton x:Name="EngineGoogle" Content="Google" GroupName="Engine" Checked="OnEngineChanged" />
                                                <RadioButton x:Name="EngineClaude" Content="Claude" GroupName="Engine" Checked="OnEngineChanged" />
                                                <RadioButton x:Name="EngineOpenAi" Content="{ui:L settings.engine.openai}" GroupName="Engine" Checked="OnEngineChanged" />
                                            </StackPanel>
                                        </Border>
                                        <TextBlock x:Name="EngineHint" Style="{StaticResource MutedLabel}" TextWrapping="Wrap" Margin="0,4,0,6" />
                                    </StackPanel>
                                </Border>
        
                                <StackPanel x:Name="ClaudePanel" Visibility="Collapsed">
                                    <TextBlock Style="{StaticResource SectionTitle}" Text="Claude · Anthropic" />
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <Grid Style="{StaticResource Row}">
                                                <TextBlock Style="{StaticResource Label}" Text="{ui:L settings.apikey}" />
                                                <PasswordBox x:Name="ClaudeKey" Width="250" HorizontalAlignment="Right" FlowDirection="LeftToRight" />
                                            </Grid>
                                            <Grid Style="{StaticResource Row}">
                                                <TextBlock Style="{StaticResource Label}" Text="{ui:L settings.model}" />
                                                <ComboBox x:Name="ClaudeModel" Width="250" HorizontalAlignment="Right" FlowDirection="LeftToRight" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
        
                                <StackPanel x:Name="OpenAiPanel" Visibility="Collapsed">
                                    <TextBlock Style="{StaticResource SectionTitle}" Text="{ui:L settings.engine.openai.title}" />
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource MutedLabel}" TextWrapping="Wrap" Margin="0,4,0,4"
                                                       Text="{ui:L settings.engine.openai.hint}" />
                                            <Grid Style="{StaticResource Row}">
                                                <TextBlock Style="{StaticResource Label}" Text="Base URL" />
                                                <TextBox x:Name="OpenAiUrl" Style="{StaticResource Field}" />
                                            </Grid>
                                            <Grid Style="{StaticResource Row}">
                                                <TextBlock Style="{StaticResource Label}" Text="{ui:L settings.apikey}" />
                                                <PasswordBox x:Name="OpenAiKey" Width="250" HorizontalAlignment="Right" FlowDirection="LeftToRight" />
                                            </Grid>
                                            <Grid Style="{StaticResource Row}">
                                                <TextBlock Style="{StaticResource Label}" Text="{ui:L settings.model}" />
                                                <TextBox x:Name="OpenAiModel" Style="{StaticResource Field}" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
        
                                <StackPanel x:Name="TestPanel" Orientation="Horizontal" Margin="0,12,0,0" Visibility="Collapsed">
                                    <Button x:Name="TestButton" Style="{StaticResource FlatButton}" Content="{ui:L settings.test}" Click="OnTestEngine" />
                                    <TextBlock x:Name="TestResult" Style="{StaticResource MutedLabel}" Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="330" />
                                </StackPanel>
                            </StackPanel>
        
                            <!-- ===== About ===== -->
                            <StackPanel x:Name="PageAbout" Visibility="Collapsed">
                                <Border Style="{StaticResource Card}" Margin="0,18,0,0" Padding="20,18">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <Image x:Name="AboutLogo" Width="48" Height="48" Margin="0,0,14,0" />
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource Label}" FontSize="18" FontWeight="SemiBold" Text="ScreenTranslator" />
                                                <TextBlock x:Name="AboutVersion" Style="{StaticResource MutedLabel}" />
                                            </StackPanel>
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource Label}" TextWrapping="Wrap" LineHeight="24"
                                                   Text="{ui:L settings.about.tagline}" />
                                        <Rectangle Height="1" Fill="{DynamicResource Divider}" Margin="0,14" />
                                        <TextBlock Style="{StaticResource MutedLabel}" TextWrapping="Wrap" LineHeight="22"
                                                   Text="{ui:L settings.about.stack}" />
                                        <TextBlock Style="{StaticResource MutedLabel}" Margin="0,8,0,0"
                                                   Text="{ui:L settings.about.keys}" />
                                        <Rectangle Height="1" Fill="{DynamicResource Divider}" Margin="0,14" />
                                        <TextBlock Style="{StaticResource MutedLabel}">
                                            <Run Text="{ui:L settings.about.by}" />
                                            <Hyperlink NavigateUri="https://msjr.ir/work/screentranslator?ref=app" RequestNavigate="OnOpenLink"
                                                       Foreground="{StaticResource Accent}" TextDecorations="{x:Null}" ToolTip="msjr.ir">
                                                <Run Text="MSJR" FontWeight="SemiBold" /><Run Text="  ·  msjr.ir ↗" />
                                            </Hyperlink>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                                <Button Style="{StaticResource FlatButton}" Content="{ui:L settings.about.welcome}" HorizontalAlignment="Left" Margin="0,14,0,0" Click="OnShowWelcome" />
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Grid>

                <!-- Footer -->
                <Grid Grid.Row="2" Margin="22,12,22,18">
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource AccentButton}" Content="{ui:L common.save}" Width="104" Click="OnSave" Margin="0,0,8,0" />
                        <Button Style="{StaticResource FlatButton}" Content="{ui:L common.close}" Width="90" Click="OnClose" />
                    </StackPanel>
                    <TextBlock x:Name="SavedHint" Style="{StaticResource MutedLabel}" HorizontalAlignment="Right" VerticalAlignment="Center" Opacity="0" Text="{ui:L common.saved}" />
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
